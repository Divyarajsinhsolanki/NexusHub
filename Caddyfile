{
	servers {
		timeouts {
			read_header 10s
			read_body 5m
			idle 2m
		}
		max_header_size 32KB
	}
}

{$APP_DOMAIN:localhost} {
	encode zstd gzip
	request_body {
		max_size 110MiB
	}
	reverse_proxy web:3000

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	log {
		output stdout
		format json
	}
}
