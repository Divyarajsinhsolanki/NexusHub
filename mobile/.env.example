EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1
EXPO_PUBLIC_WEB_URL=http://localhost:3000
# Physical Android development builds must use the computer's LAN address for
# both values above. Loopback may only be enabled for explicit port-forwarding.
EXPO_PUBLIC_ALLOW_LOOPBACK=false
EXPO_PUBLIC_ALLOW_INSECURE_DEV=true
EXPO_PUBLIC_SENTRY_DSN=
SENTRY_DISABLE_AUTO_UPLOAD=true
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
GOOGLE_IOS_URL_SCHEME=
GOOGLE_SERVICES_JSON=
GOOGLE_SERVICE_INFO_PLIST=
EAS_PROJECT_ID=
EXPO_PUBLIC_APP_VARIANT=development
