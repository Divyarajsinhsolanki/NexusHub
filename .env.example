# Production email delivery (Postmark uses HTTPS, so it works on Render)
POSTMARK_SERVER_TOKEN=replace_with_your_server_api_token
MAILER_SENDER="Nexus Hub <you@company.example>"
ERROR_NOTIFICATION_EMAIL=you@example.com
BASE_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173

# Optional local SMTP server. Production does not use these values.
SMTP_ADDRESS=smtp.example.com
SMTP_PORT=587
SMTP_DOMAIN=example.com
SMTP_USERNAME=your_username
SMTP_PASSWORD=your_password
SMTP_SSL=false
SMTP_STARTTLS=true
SMTP_OPEN_TIMEOUT=5
SMTP_READ_TIMEOUT=5
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081,http://127.0.0.1:8081
CORS_ALLOWED_PATH=/api/*

# Third-party API keys
VITE_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5
VITE_GNEWS_API_KEY=
VITE_NEWSAPI_KEY=
VITE_FINANCIAL_MODELING_PREP_API_KEY=
VITE_ALPHA_VANTAGE_API_KEY=
VITE_NEWSDATA_API_KEY=
VITE_GUARDIAN_API_KEY=
VITE_WORDNIK_API_KEY=
VITE_NASA_API_KEY=

# Firebase web app config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Keka integration. Keep this value stable; changing it invalidates saved credentials.
KEKA_API_KEY_ENCRYPTION_KEY=

# Rails encryption key
RAILS_MASTER_KEY=
SECRET_KEY_BASE=

# Optional: customize Puma threads/workers
RAILS_MAX_THREADS=5
RAILS_MIN_THREADS=5
WEB_CONCURRENCY=2

# Database connection
DB_HOST=localhost
POSTGRES_PASSWORD=replace-with-a-long-random-password
# DATABASE_URL=

# Database sync helpers for local <-> Render/external PostgreSQL.
# Keep the real URL only in your local .env or shell environment.
RENDER_DATABASE_URL=
EXTERNAL_DATABASE_URL=
LOCAL_DATABASE_URL=postgresql://postgres:postgres@localhost/pdf_master_development
DATABASE_SYNC_DIR=tmp/database-sync
# POSTGRES_CLIENT_IMAGE=postgres:18-alpine

# Redis for Action Cable
REDIS_URL=redis://localhost:6379/1

# LiveKit self-hosted WebRTC/SFU. bin/dev starts a local Docker-backed server
# when Docker is available. LIVEKIT_URL must be reachable by browsers, e.g.
# ws://localhost:7880 locally or wss://livekit.example.com in production.
# On Render, use a LiveKit Cloud project URL; do not use localhost and keep the
# API secret only in Render's server-side environment variables.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=dev-secret-change-me-32-characters-min

# Active Storage (development uses local disk; production defaults to cloudinary)
ACTIVE_STORAGE_SERVICE=local
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1
S3_BUCKET=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false

# Production domain and observability
APP_DOMAIN=localhost
ALLOWED_HOSTS=localhost
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
BACKUP_RETENTION_DAYS=14

# Slack notifications
SLACK_WEBHOOK_URL=

# Misc settings
RAILS_LOG_LEVEL=info
CI=false
RACK_ATTACK_LOGIN_PER_MINUTE=20
RACK_ATTACK_REQUESTS_PER_MINUTE=300
RACK_ATTACK_SIGNUP_PER_HOUR=10
RACK_ATTACK_DEMO_PER_MINUTE=20
DEMO_MODE_ENABLED=false
PORTFOLIO_ENABLED=false
# Bootstrap controls. Demo data is synthetic and may be seeded while access remains disabled.
SEED_PORTFOLIO=true
SEED_DEMO=true
PORTFOLIO_ADMIN_EMAIL=
# DEVISE_JWT_SECRET_KEY=
