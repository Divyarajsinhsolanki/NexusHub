# Set both URLs to the same source DB, preferably using a dedicated read-only
# role with SELECT on all application tables/sequences and matching default grants.
DATABASE_URL=postgres://backup_reader:replace-password@db:5432/nexus_hub_production
BACKUP_DATABASE_URL=postgres://backup_reader:replace-password@db:5432/nexus_hub_production
# Separate offsite account/bucket. Never give the backup writer the GPG private key.
AWS_DEFAULT_REGION=ap-south-1
BACKUP_S3_BUCKET=replace-with-offsite-bucket
BACKUP_S3_PREFIX=nexus/production
BACKUP_S3_EXPECTED_OWNER=000000000000
BACKUP_S3_KMS_KEY_ID=replace-with-offsite-kms-key-arn
BACKUP_OFFSITE_RETENTION_DAYS=35
BACKUP_LOCAL_RETENTION_DAYS=14
BACKUP_KEYSET_ID=replace-with-secret-escrow-version
# Prefer an instance/task role or mounted credentials file restricted to this writer.
# AWS_SHARED_CREDENTIALS_FILE=/run/secrets/backup-writer
