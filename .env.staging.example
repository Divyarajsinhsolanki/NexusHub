# Use only with docker-compose.staging.yml. Never copy a production .env.
# Generate independent random values; backup keyring/signing keys must not be reused here.
STAGING_POSTGRES_PASSWORD=replace-with-url-safe-random-password
SECRET_KEY_BASE=replace-with-independent-random-secret
DEVISE_JWT_SECRET_KEY=replace-with-another-independent-secret
INTEGRATION_ENCRYPTION_KEYS={"v1":"replace-with-64-hex-characters"}
INTEGRATION_ENCRYPTION_ACTIVE_KEY_ID=v1
# Generate a separate 64-character hexadecimal key for project operations.
PROJECT_OPERATIONS_ENCRYPTION_KEY=replace-me
PORTFOLIO_ENABLED=false
