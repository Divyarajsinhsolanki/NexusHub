<%= email_heading 'Production error detected', eyebrow: 'Application alert', intro: 'Review the exception and request details below to investigate.' %>
<%= email_details 'Exception' => @exception_class, 'Message' => @message %>
<h2 style="font-size:16px;color:#172033;">Request context</h2>
<%= email_details @request_context.transform_values(&:inspect) %>
<h2 style="font-size:16px;color:#172033;">Backtrace</h2>
<%= email_code_block @backtrace.join("\n") %>
