<%= email_heading @issue.title, eyebrow: "Issue #{@issue.issue_key || @issue.id}", intro: 'An issue you own or are assigned to has been updated.' %>
<%= email_details 'Project' => (@issue.project&.name || "Project ##{@issue.project_id}"), 'Status' => (@previous_status && @previous_status != @issue.status ? "#{@previous_status} → #{@issue.status}" : @issue.status), 'Assignee' => (@previous_assignee && @previous_assignee != @issue.assignee ? "#{@previous_assignee} → #{@issue.assignee.presence || 'Unassigned'}" : (@issue.assignee.presence || 'Unassigned')), 'Due date' => (@issue.due_date&.strftime('%Y-%m-%d') || 'Not set') %>
<h2 style="font-size:16px;color:#172033;">Description</h2>
<p style="white-space:pre-wrap;"><%= @issue.issue_description.presence || 'No description provided.' %></p>
<%= email_button 'View issue', root_url + "projects/#{@issue.project_id}/issues?issue_id=#{@issue.id}" %>
<%= email_note 'You are receiving this email because you are listed as the owner or assignee.' %>
