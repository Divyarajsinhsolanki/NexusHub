<%= email_heading 'A good time to revisit this', eyebrow: 'Knowledge Hub reminder', intro: "Hi #{@user.first_name.presence || @user.email}, take a moment to review one of your saved items." %>
<% details = { 'Category' => @bookmark.card_type.humanize, 'Saved on' => @bookmark.created_at.strftime('%B %d, %Y') } %>
<% details['Collection'] = @bookmark.collection_name if @bookmark.collection_name.present? %>
<%= email_details details %>
<h2 style="font-size:16px;color:#172033;">Saved details</h2>
<%= email_code_block JSON.pretty_generate(@bookmark.payload) %>
<%= email_button 'Open Knowledge Hub', root_url + 'knowledge' %>
<p style="font-size:12px;color:#64748b;">Review this item and mark it as done when you are ready.</p>
