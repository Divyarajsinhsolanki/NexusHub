<% frontend_base = ENV.fetch('FRONTEND_URL', root_url) %>
<% frontend_base = "#{frontend_base}/" unless frontend_base.ends_with?('/') %>
<% reset_link = "#{frontend_base}reset-password?token=#{CGI.escape(@token)}&email=#{CGI.escape(@resource.email)}" %>
<%= email_heading 'Choose a new password', eyebrow: 'Account security', intro: 'We received a request to reset your Nexus Hub password. Use the button below to choose a new one.' %>
<%= email_details 'Account' => @resource.email, 'Link expires' => distance_of_time_in_words(0, Devise.reset_password_within) %>
<%= email_button 'Reset password', reset_link %>
<%= email_note 'If you did not ask for this, you can ignore this email. Your password will stay the same until you choose a new one.' %>
