<%= email_heading "Welcome, #{@resource.first_name.presence || 'there'}", eyebrow: 'Confirm your account', intro: 'Confirm your email address to get started with Nexus Hub.' %>
<%= email_details 'Email address' => @resource.email %>
<%= email_button 'Confirm my account', user_confirmation_url(confirmation_token: @token) %>
<%= email_note 'If you did not create this account, you can ignore this email.' %>
