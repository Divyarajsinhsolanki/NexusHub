<%= email_heading @event.title, eyebrow: 'Calendar reminder', intro: "Hi #{@user.first_name.presence || @user.email}, your event is coming up." %>
<% details = { 'Starts at' => @event.start_at.in_time_zone.strftime('%B %d, %Y at %I:%M %p %Z'), 'Reminder' => "#{@event_reminder.minutes_before} minutes before" } %>
<% details['Description'] = @event.description if @event.description.present? %>
<% details['Location / Link'] = @event.location_or_meet_link if @event.location_or_meet_link.present? %>
<%= email_details details %>
<%= email_button 'Open calendar', root_url + 'calendar' %>
